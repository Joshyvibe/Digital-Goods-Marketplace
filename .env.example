# Copy to api/.env for local dev (docker-compose reads api/.env directly).

# Django
DJANGO_SECRET_KEY=change-me-in-every-environment
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Railway/Neon provide this in production). Local docker-compose maps Postgres
# to host port 5434 and Redis to 6381 to avoid clashing with other local projects' default
# 5432/6379 — adjust if that's not an issue on your machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/marketplace

# Frontend origin(s) allowed to make credentialed requests
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth — create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials, add http://localhost:3000 as an
# authorized JavaScript origin. Only the client ID is needed server-side (ID-token
# verification, no OAuth secret exchange).
GOOGLE_OAUTH_CLIENT_ID=

# Stripe (test mode keys from the Stripe dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_RATE=0.15

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketplace-dev
R2_ENDPOINT_URL=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6381/0
